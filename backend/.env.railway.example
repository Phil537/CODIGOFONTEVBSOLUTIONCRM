# Variáveis mínimas para produção no Railway (Service → Variables).
# Substitua pelos seus valores reais. Nunca commite .env com segredos.

NODE_ENV=production
DEV_NO_DB=false

BACKEND_URL=https://SEU-BACKEND.up.railway.app
PUBLIC_BACKEND_URL=https://SEU-BACKEND.up.railway.app
FRONTEND_URL=https://SEU-FRONTEND.vercel.app

JWT_SECRET=gere-com-openssl-rand-base64-32
JWT_REFRESH_SECRET=gere-outro-segredo-forte

# Railway injeta automaticamente ao vincular Postgres (prefira DATABASE_URL interna):
# DATABASE_URL=postgresql://...
# DATABASE_PUBLIC_URL=postgresql://...

REDIS_URI=${{REDIS_URL}}
REDIS_URI_ACK=${{REDIS_URL}}

VERIFY_TOKEN=vbsolution
USE_WHATSAPP_OFICIAL=true
SOCKET_ADMIN=true
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# Meta (Facebook / Instagram / WhatsApp Oficial)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
