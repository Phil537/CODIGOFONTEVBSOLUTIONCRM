# Copie estes valores nas Environment Variables do projeto Vercel (Production + Preview).
# REACT_APP_* entra no build — após alterar, faça Redeploy.

REACT_APP_BACKEND_URL=https://SEU-BACKEND.up.railway.app
REACT_APP_NAME_SYSTEM=VB Solution
REACT_APP_NUMBER_SUPPORT=
REACT_APP_FACEBOOK_APP_ID=
REACT_APP_REQUIRE_BUSINESS_MANAGEMENT=TRUE

CI=false
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
DISABLE_ESLINT_PLUGIN=true
TSC_COMPILE_ON_ERROR=true
ESLint_NO_DEV_ERRORS=true
